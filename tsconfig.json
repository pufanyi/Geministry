{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"]
}
